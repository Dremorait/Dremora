{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "dremorait.in" }], "destination": "https://www.dremorait.in/:path*", "statusCode": 301 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "dremora-it.vercel.app" }], "destination": "https://www.dremorait.in/:path*", "statusCode": 301 },
    { "source": "/:path*", "has": [{ "type": "host", "value": "dremora-sigma.vercel.app" }], "destination": "https://www.dremorait.in/:path*", "statusCode": 301 },

    { "source": "/intern-dashboard.html", "has": [{ "type": "query", "key": "verify", "value": "(?<id>[A-Za-z0-9-]+)" }], "destination": "/internship?verify=:id", "statusCode": 301 },
    { "source": "/intern-dashboard", "has": [{ "type": "query", "key": "verify", "value": "(?<id>[A-Za-z0-9-]+)" }], "destination": "/internship?verify=:id", "statusCode": 301 },

    { "source": "/index.html", "destination": "/", "statusCode": 301 },
    { "source": "/about.html", "destination": "/about", "statusCode": 301 },
    { "source": "/services.html", "destination": "/services", "statusCode": 301 },
    { "source": "/projects.html", "destination": "/work", "statusCode": 301 },
    { "source": "/projects", "destination": "/work", "statusCode": 301 },
    { "source": "/contact.html", "destination": "/contact", "statusCode": 301 },
    { "source": "/internship.html", "destination": "/internship", "statusCode": 301 },
    { "source": "/course-guidelines.html", "destination": "/internship/guidelines", "statusCode": 301 },
    { "source": "/course-guidelines", "destination": "/internship/guidelines", "statusCode": 301 },
    { "source": "/privacy-policy.html", "destination": "/privacy-policy", "statusCode": 301 },
    { "source": "/terms-of-service.html", "destination": "/terms", "statusCode": 301 },
    { "source": "/terms-of-service", "destination": "/terms", "statusCode": 301 },
    { "source": "/refund-policy.html", "destination": "/refund-policy", "statusCode": 301 }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=(), browsing-topics=()" }
      ]
    },
    {
      "source": "/((?!intern-dashboard|admin-login|admin-dashboard).*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'sha256-wsmnxD6kqdZZ/V2wQ85d92sMux2lvh7NN1y5/Y5SS5c='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests" }
      ]
    },
    {
      "source": "/(intern-dashboard|admin-login|admin-dashboard)(.html)?",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://vtutbqzkegkgujrdkxmj.supabase.co wss://vtutbqzkegkgujrdkxmj.supabase.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "(?<preview>.*)\\.vercel\\.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ]
}
