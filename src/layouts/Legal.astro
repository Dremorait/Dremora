---
// Long documents: page hero with dates, then contents in a sticky side card and the text.
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import { legal } from '../content/site';
import type { PageMeta } from '../content/pages';

interface Props {
  page: PageMeta;
  name: string;
  summary?: string[];
  sections: [id: string, title: string][];
  lastUpdated?: string;
  effective?: string;
  label?: string;
  crumbs?: { name: string; path: string }[];
}
const {
  page,
  name,
  summary = [],
  sections,
  lastUpdated = legal.lastUpdated,
  effective = legal.effectiveDate,
  label = 'Legal',
  crumbs = [{ name, path: page.path }],
} = Astro.props;
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base page={page} crumbs={crumbs}>
  <PageHero label={label} title={name} crumbs={crumbs}>
    <ul class="chips">
      {effective && <li><b>Effective</b> {fmt(effective)}</li>}
      <li><b>Last updated</b> {fmt(lastUpdated)}</li>
    </ul>
  </PageHero>
  <section class="section">
    <div class="wrap doc-layout">
      <aside class="doc-toc">
        <nav aria-labelledby="toc-title">
          <h2 id="toc-title">Contents</h2>
          <ol>{sections.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
        </nav>
      </aside>
      <div class="prose">
        {summary.length > 0 && (
          <div class="summary-box">
            <h2 style="margin-top: 0; font-size: 1.25rem">In short</h2>
            <ul>{summary.map((s) => <li>{s}</li>)}</ul>
          </div>
        )}
        <slot />
      </div>
    </div>
  </section>
</Base>
