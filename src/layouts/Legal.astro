---
import Base from './Base.astro';
import { legal } from '../content/site';
import type { PageMeta } from '../content/pages';

interface Props {
  page: PageMeta;
  name: string;
  summary: string[];
  sections: [id: string, title: string][];
  lastUpdated?: string;
  effective?: string;
}
const { page, name, summary, sections, lastUpdated = legal.lastUpdated, effective = legal.effectiveDate } = Astro.props;
const fmt = (d: string) => new Date(d + 'T00:00:00').toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base page={page} crumbs={[{ name, path: page.path }]}>
  <section class="page-head wrap">
    <h1>{name}</h1>
    <p class="mono muted">Effective date: {fmt(effective)}<br />Last updated: {fmt(lastUpdated)}</p>
  </section>
  <section class="section">
    <div class="wrap prose">
      <div class="summary-box">
        <h2 style="margin-top: 0; font-size: 1.25rem">In short</h2>
        <ul>{summary.map((s) => <li>{s}</li>)}</ul>
      </div>
      <nav class="toc" aria-labelledby="toc-title">
        <h2 id="toc-title" style="margin-top: 0; font-size: 1.25rem">Contents</h2>
        <ol>{sections.map(([id, t]) => <li><a href={`#${id}`}>{t}</a></li>)}</ol>
      </nav>
      <slot />
    </div>
  </section>
</Base>
