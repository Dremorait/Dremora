---
// Top of every inner page: breadcrumb, centred title and intro on the soft wash.
// Put buttons or fact chips in the default slot.
type Crumb = { name: string; path: string };
interface Props {
  title: string;
  lead?: string;
  label?: string;
  crumbs?: Crumb[];
  tall?: boolean;
}
const { title, lead, label, crumbs = [], tall = false } = Astro.props;
---
<section class:list={['page-hero', { 'page-hero-tall': tall }]} aria-labelledby="page-title">
  <div class="wrap">
    {crumbs.length > 0 && (
      <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => (
            <li>{i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
          ))}
        </ol>
      </nav>
    )}
    <div class="page-hero-inner center">
      {label && <p class="label">{label}</p>}
      <h1 id="page-title">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
  </div>
</section>
