---
import { NEEDS, BUDGETS } from '../../api/_lib/contact-rules.js';

---
<form class="form" id="contact-form" action="/api/contact" method="post" data-contact-form>
  <div class="notice error" id="cf-summary" role="alert" tabindex="-1" hidden></div>

  <div class="form-2">
    <div class="field">
      <label for="cf-name">Your name</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" aria-describedby="cf-name-err" />
      <p class="error" id="cf-name-err" hidden></p>
    </div>
    <div class="field">
      <label for="cf-contact">Phone or email</label>
      <input id="cf-contact" name="contact" type="text" autocomplete="email" required maxlength="200" aria-describedby="cf-contact-hint cf-contact-err" />
      <p class="hint" id="cf-contact-hint">We reply on whichever you give us.</p>
      <p class="error" id="cf-contact-err" hidden></p>
    </div>
  </div>

  <div class="form-2">
    <div class="field">
      <label for="cf-business">Business name <span class="muted">(optional)</span></label>
      <input id="cf-business" name="business" type="text" autocomplete="organization" maxlength="120" aria-describedby="cf-business-err" />
      <p class="error" id="cf-business-err" hidden></p>
    </div>
    <div class="field">
      <label for="cf-need">What you need</label>
      <select id="cf-need" name="need" required aria-describedby="cf-need-err">
        <option value="">Choose one</option>
        {Object.entries(NEEDS).map(([v, l]) => <option value={v}>{l}</option>)}
      </select>
      <p class="error" id="cf-need-err" hidden></p>
    </div>
  </div>

  <div class="field">
    <label for="cf-budget">Budget in INR <span class="muted">(optional)</span></label>
    <select id="cf-budget" name="budget" aria-describedby="cf-budget-err">
      <option value="">Prefer not to say</option>
      {Object.entries(BUDGETS).map(([v, l]) => <option value={v}>{l}</option>)}
    </select>
    <p class="error" id="cf-budget-err" hidden></p>
  </div>

  <div class="field">
    <label for="cf-message">Message</label>
    <textarea id="cf-message" name="message" required maxlength="4000" aria-describedby="cf-message-hint cf-message-err"></textarea>
    <p class="hint" id="cf-message-hint">What does the business do, and what should the new website or system handle?</p>
    <p class="error" id="cf-message-err" hidden></p>
  </div>

  <div class="hp" aria-hidden="true">
    <label for="cf-website">Leave this field empty</label>
    <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="field">
    <div class="check">
      <input id="cf-consent" name="consent" type="checkbox" required aria-describedby="cf-consent-err" />
      <label for="cf-consent">I agree to Dremora IT contacting me about this enquiry, as described in the <a href="/privacy-policy">Privacy Policy</a>.</label>
    </div>
    <p class="error" id="cf-consent-err" hidden></p>
  </div>

  <div class="actions" style="margin-top: 0">
    <button class="btn btn-primary" type="submit">Send enquiry</button>
    <p class="muted" id="cf-status" role="status" aria-live="polite" style="margin: 0"></p>
  </div>
</form>

<script>
  import { validateContact } from '../../api/_lib/contact-rules.js';

  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    form.noValidate = true; // JS shows its own messages; without JS the browser validates
    const summary = form.querySelector<HTMLElement>('#cf-summary')!;
    const status = form.querySelector<HTMLElement>('#cf-status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const fieldNames = ['name', 'contact', 'business', 'need', 'budget', 'message', 'consent'];

    const showErrors = (errors: Record<string, string>) => {
      for (const name of fieldNames) {
        const input = form.elements.namedItem(name) as HTMLInputElement;
        const out = form.querySelector<HTMLElement>(`#cf-${name}-err`)!;
        if (errors[name]) {
          input.setAttribute('aria-invalid', 'true');
          out.textContent = errors[name];
          out.hidden = false;
        } else {
          input.removeAttribute('aria-invalid');
          out.textContent = '';
          out.hidden = true;
        }
      }
      const count = Object.keys(errors).length;
      if (count) {
        summary.innerHTML = '';
        const p = document.createElement('p');
        p.textContent = count === 1 ? 'One field needs fixing before we can send this.' : `${count} fields need fixing before we can send this.`;
        summary.append(p);
        summary.hidden = false;
        (form.elements.namedItem(Object.keys(errors)[0]) as HTMLElement).focus();
      } else {
        summary.hidden = true;
      }
    };

    const showFailure = (text: string) => {
      summary.innerHTML = '';
      const p = document.createElement('p');
      p.textContent = text;
      const p2 = document.createElement('p');
      p2.innerHTML = 'Your message is still in the form. You can also call <a href="tel:+919309795878">+91 9309795878</a> or <a href="https://wa.me/919309795878">message us on WhatsApp</a>.';
      summary.append(p, p2);
      summary.hidden = false;
      summary.focus();
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const raw = Object.fromEntries(new FormData(form)) as Record<string, string>;
      const { errors } = validateContact(raw);
      showErrors(errors);
      if (Object.keys(errors).length) return;

      button.disabled = true;
      status.textContent = 'Sending...';
      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(raw),
        });
        const body = await res.json().catch(() => ({}));
        if (res.ok && body.ok) {
          window.location.assign('/contact/thanks');
          return;
        }
        status.textContent = '';
        if (res.status === 400 && body.errors) showErrors(body.errors);
        else if (res.status === 429) showFailure('Too many messages from this connection in a short time. Please wait a few minutes and try again.');
        else showFailure('Something went wrong on our side and the message was not sent.');
      } catch {
        status.textContent = '';
        showFailure('The message could not be sent. Check your internet connection and try again.');
      } finally {
        button.disabled = false;
      }
    });
  }
</script>
