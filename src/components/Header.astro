---
import Logo from './Logo.astro';
import { services } from '../content/site';

const path = Astro.url.pathname.replace(/(\/index)?\.html$/, '').replace(/\/$/, '') || '/';
const isHome = path === '/';
const nav = [
  { href: '/services', label: 'Services' },
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const current = (href: string) => (path === href || path.startsWith(href + '/') ? 'page' : undefined);
const subnav = [{ href: '/services', label: 'All services' }, ...services.map((s) => ({ href: `/services/${s.slug}`, label: s.name }))];
const arrow = '<svg class="btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>';
---
<header class="site-header">
  <div class="wrap">
    <a class="brand" href="/" aria-label="Dremora IT, home">
      <Logo variant="wordmark" label="" />
    </a>

    <nav class="site-nav" aria-label="Main">
      {/* Services opens a dropdown on hover and keyboard focus, no script. The link itself still goes to /services. */}
      <ul class="nav-list">
        {nav.map((n) => n.href === '/services'
          ? (
            <li class="nav-dd">
              <a href={n.href} aria-current={current(n.href)}>
                {n.label}
                <svg class="nav-dd-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
              </a>
              <ul class="nav-dd-menu">
                {subnav.map((s) => <li><a href={s.href} aria-current={path === s.href ? 'page' : undefined}>{s.label}</a></li>)}
              </ul>
            </li>
          )
          : <li><a href={n.href} aria-current={current(n.href)}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="header-actions">
    {/* On the home page the hero carries the one primary button, so the header uses a plain link. */}
    {isHome
      ? <a class="header-cta header-link-quote" href="/contact">Get a quote<Fragment set:html={arrow} /></a>
      : <a class="header-cta btn btn-primary" href="/contact">Get a quote<Fragment set:html={arrow} /></a>}

    <button class="icon-btn menu-toggle" type="button" popovertarget="mobile-menu" aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" popover aria-label="Menu">
    <div class="mobile-menu-top">
      <a class="brand" href="/" aria-label="Dremora IT, home"><Logo variant="wordmark" label="" /></a>
      <button class="icon-btn" type="button" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18M6 6l12 12" /></svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul>
        <li><a href="/">Home</a></li>
        {nav.map((n) => (
          <li>
            <a href={n.href} aria-current={current(n.href)}>{n.label}</a>
            {n.href === '/services' && (
              <ul class="mobile-sub">
                {services.map((s) => <li><a href={`/services/${s.slug}`} aria-current={current(`/services/${s.slug}`)}>{s.name}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary" href="/contact">Get a quote<Fragment set:html={arrow} /></a>
  </div>
</header>
