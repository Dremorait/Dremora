---
// Founder block: round photo, name and role, and a signed message. The About page also
// shows the studio story under it. Callers render it only when showFounder() is true.
import { Image } from 'astro:assets';
import Fact from './Fact.astro';
import { founder, story, isTodo, known } from '../content/site';
import { founderPhoto as photo } from '../content/founder-photo';
const { headingId = 'founder-title', headingLevel = 2, withStory = false } = Astro.props as { headingId?: string; headingLevel?: 2 | 3; withStory?: boolean };
const H = `h${headingLevel}`;
---
<div class="founder">
  {photo
    ? <Image class="founder-photo" src={photo} alt={`${founder.name}, ${founder.role} of Dremora IT`} width={220} height={220} densities={[1, 2, 3]} format="webp" />
    : <p class="todo"><Fact v={founder.photo} /></p>}
  <div>
    <H id={headingId}><Fact v={founder.name} /><span class="founder-role"><Fact v={founder.role} /></span></H>
    <blockquote class="founder-message">
      {founder.message.map((m) => <p>{m}</p>)}
    </blockquote>
    {withStory && story.map((s) => <p>{s}</p>)}
    {known(founder.linkedin) && (isTodo(founder.linkedin) ? <p><Fact v={founder.linkedin} /></p> : <a href={founder.linkedin}>LinkedIn profile</a>)}
  </div>
</div>
