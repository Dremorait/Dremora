---
// The Dremora logo mark (D with pixels and orbit), bare: no tile, border or glow.
// Dark mode swaps in a version with the navy turned white (made by scripts/make-icons.mjs),
// shown by global.css so it follows both the system setting and the theme toggle.
// loading="lazy" so the hidden one (display: none) is never downloaded.
import { Image } from 'astro:assets';
import mark from '../assets/brand/dremora-mark.png';
import markDark from '../assets/brand/dremora-mark-dark.png';

const { size = 'sm' } = Astro.props as { size?: 'sm' | 'lg' };
const width = size === 'lg' ? 88 : 34; // displayed width; densities add 2x and 3x files for sharp screens
---
<span class:list={['brand-tile', `brand-tile-${size}`]}>
  <Image class="mark-light" src={mark} alt="Dremora IT logo" width={width} densities={[1, 2, 3]} format="webp" loading="lazy" />
  <Image class="mark-dark" src={markDark} alt="Dremora IT logo" width={width} densities={[1, 2, 3]} format="webp" loading="lazy" />
</span>
