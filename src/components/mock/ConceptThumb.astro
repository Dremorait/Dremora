---
// Small picture for each concept build card. A real screenshot of the demo when one is in
// src/assets/concepts/<slug>.png (cropped so no made-up stats, ratings, revenue or
// "Dremora" brand names show); otherwise a stylised page of that kind of site, drawn in CSS.
import { Image } from 'astro:assets';
import { concepts } from '../../content/site';

const { kind } = Astro.props as { kind: string };
const shots = import.meta.glob<{ default: ImageMetadata }>('../../assets/concepts/*.png', { eager: true });
const shot = shots[`../../assets/concepts/${kind}.png`]?.default;
const name = concepts.find((c) => c.slug === kind)?.name.split(',')[0] ?? 'concept';
---
<div class:list={['thumb', `thumb-${kind}`, { 'thumb-shot': shot }]} aria-hidden={shot ? undefined : 'true'}>
  <div class="thumb-frame">
    <div class="thumb-bar" aria-hidden="true"><i></i><i></i><i></i></div>
    {shot ? <Image class="thumb-img" src={shot} alt={`Screenshot of the ${name} concept demo, with sample content`} widths={[360, 560, 840, 1024]} sizes="(min-width: 1240px) 340px, (min-width: 900px) calc(33vw - 80px), (min-width: 600px) calc(50vw - 84px), calc(100vw - 84px)" format="webp" loading="lazy" /> : (
    <div class="thumb-page">
      {kind === 'eduro' && (<>
        <div class="t-row"><span class="t-side"></span><span class="t-stack"><span class="t-chart"><b style="height:40%"></b><b style="height:70%"></b><b style="height:55%"></b><b style="height:85%"></b><b style="height:60%"></b></span><span class="t-line w60"></span></span></div>
      </>)}
      {kind === 'dre-chain' && (<>
        <div class="t-flow"><span>Email</span><i></i><span>AI check</span><i></i><span>CRM</span><i></i><span>WhatsApp</span></div>
      </>)}
      {kind === 'hotel' && (<>
        <div class="t-hero-img"></div><span class="t-line w50"></span><span class="t-line w30"></span>
      </>)}
      {kind === 'restaurant' && (<>
        <span class="t-line w40"></span>
        <div class="t-menu"><span></span><span></span><span></span><span></span></div>
      </>)}
      {kind === 'clinic' && (<>
        <span class="t-line w60"></span><span class="t-line w40"></span><span class="t-pill"></span>
        <div class="t-cards"><span></span><span></span><span></span></div>
      </>)}
      {kind === 'online-store' && (<>
        <div class="t-grid"><span></span><span></span><span></span><span></span><span></span><span></span></div>
      </>)}
    </div>
    )}
  </div>
</div>
