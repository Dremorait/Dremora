---
// One portfolio project: its hero in a browser window with the phone view overlapping,
// then what it is and links to the project page and the live site.
// layout="card" for three-up grids; layout="row" for the wide rows on the Work page.
import { Image } from 'astro:assets';
import type { PortfolioItem } from '../content/site';

const { item, layout = 'card', headingLevel = 3 } = Astro.props as { item: PortfolioItem; layout?: 'card' | 'row'; headingLevel?: 2 | 3 };
const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/*.webp', { eager: true });
const desktop = shots[`../assets/portfolio/${item.slug}-desktop.webp`].default;
const phone = shots[`../assets/portfolio/${item.slug}-phone.webp`].default;
const domain = new URL(item.url).host;
const H = `h${headingLevel}`;
const desktopSizes = layout === 'row' ? '(min-width: 1000px) 640px, calc(100vw - 64px)' : '(min-width: 1240px) 380px, (min-width: 900px) calc(33vw - 40px), (min-width: 600px) calc(50vw - 40px), calc(100vw - 40px)';
---
<article class:list={['work', `work-${layout}`]} id={item.slug}>
  <a class="work-media" href={`/portfolio/${item.slug}`} tabindex="-1" aria-hidden="true">
    <div class="work-window">
      <div class="work-bar"><span class="work-dots"><i></i><i></i><i></i></span><span class="work-url">{domain}</span></div>
      <Image src={desktop} alt={`${item.name} website, hero section on desktop`} widths={[480, 720, 960, 1280, 1600]} sizes={desktopSizes} format="webp" quality={85} loading="lazy" />
    </div>
    <Image class="work-phone" src={phone} alt={`${item.name} website on a phone`} widths={[160, 240, 360, 480]} sizes="(min-width: 1000px) 150px, 26vw" format="webp" quality={85} loading="lazy" />
  </a>
  <div class="work-body">
    <p class="label work-label">{item.sector}</p>
    <H class="work-title"><a href={`/portfolio/${item.slug}`}>{item.name}</a></H>
    <p class="muted">{item.summary}</p>
    {layout === 'row' && <p class="work-stack">Built with {item.stack}. Website demo with sample content.</p>}
    <div class="work-links">
      <a class="arrow-link" href={`/portfolio/${item.slug}`}>See the project<span class="visually-hidden">: {item.name}</span></a>
      <a class="work-live" href={item.url} target="_blank" rel="noopener">Live site<span class="visually-hidden"> of {item.name}, opens in a new tab</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M8 7h9v9" /></svg></a>
    </div>
  </div>
</article>
