---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Fact from '../components/Fact.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site, known, process } from '../content/site';
import { pages } from '../content/pages';

const crumbs = [{ name: 'Contact', path: '/contact' }];
---
<Base page={pages.contact} crumbs={crumbs}>
  <PageHero title="Tell us what you need and get a written fixed quote" lead="The first call is free and takes 30 minutes. After it you get the scope, price and timeline in writing." crumbs={crumbs}>
    {known(site.responseTime) && <ul class="chips"><li><Fact v={site.responseTime} /></li></ul>}
  </PageHero>

  <section class="section" aria-labelledby="form-title">
    <div class="wrap grid">
      <div class="span-8 glass-card">
        <h2 id="form-title">Send an enquiry</h2>
        <ContactForm />
      </div>
      <aside class="span-4" aria-labelledby="direct-title">
        <h2 id="direct-title" style="font-size: 1.25rem">Or reach us directly</h2>
        <div class="methods">
          <a class="method" href={site.whatsapp}>
            <Icon name="chat" />
            <span><b>WhatsApp</b><small>Message us any time</small></span>
          </a>
          <a class="method" href={`tel:${site.phone.e164}`}>
            <Icon name="phone" />
            <span><b>Phone</b><small>{site.phone.display}</small></span>
          </a>
          <a class="method" href={`mailto:${site.email}`}>
            <Icon name="mail" />
            <span><b>Email</b><small>{site.email}</small></span>
          </a>
          <a class="method" href={site.address.maps}>
            <Icon name="pin" />
            <span><b>Address</b><small>{site.legalName}, {site.address.display}. Opens Google Maps.</small></span>
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="next-title">
    <div class="wrap">
      <div class="section-head"><h2 id="next-title">What happens after you send it</h2></div>
      <ol class="step-cards">
        {process.map((p) => <li><h3>{p.title}</h3><p>{p.body}</p></li>)}
      </ol>
    </div>
  </section>
</Base>
