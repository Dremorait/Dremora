---
import Base from '../../layouts/Base.astro';
import Fact from '../../components/Fact.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import { clientWork, portfolio, serviceBySlug, known, hasCaseStudy, workName } from '../../content/site';
import { pages } from '../../content/pages';

const crumbs = [{ name: 'Work', path: '/work' }];
---
<Base page={pages.work} crumbs={crumbs}>
  <PageHero title="Work for real clients, and complete websites we built" lead="Client names appear only with their written permission. Results appear only when the client agrees to publish them." crumbs={crumbs}>
    <div class="actions">
      <a class="btn btn-secondary" href="#portfolio">See the portfolio</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="client-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="client-title">Projects for paying clients</h2>
      </div>
      <div class="cards">
        {clientWork.map((w) => (
          <article class="wide-card" id={w.slug} style="max-width: none">
            <div>
              <p class="label" style="margin: 0 0 8px">Client work</p>
              <h3>{workName(w)}</h3>
              {known(w.sector) && <p class="muted"><Fact v={w.sector} /></p>}
              {known(w.shipped) && <p class="muted">Shipped <Fact v={w.shipped} /></p>}
            </div>
            <div>
              {known(w.problem) && <p><strong>Problem:</strong> <Fact v={w.problem} /></p>}
              <p><strong>What we did:</strong> {w.built}</p>
              {w.services.length > 0 && (
                <p class="muted">Service: {w.services.map((s, i) => <>{i > 0 && ', '}<a href={`/services/${s}`}>{serviceBySlug(s).name}</a></>)}</p>
              )}
              {hasCaseStudy(w) && <a class="arrow-link" href={`/work/${w.slug}`}>Read the case study</a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="portfolio" aria-labelledby="portfolio-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="portfolio-title">Portfolio</h2>
        <p>Complete websites we designed and built, one for each kind of business. They are live demos: every name, figure and review in them is sample content, and none of them is a client project.</p>
      </div>
      <div class="work-rows">
        {portfolio.map((p) => <PortfolioCard item={p} layout="row" />)}
      </div>
    </div>
  </section>

  <CtaBand title="Want a site like one of these?" text="On a 30 minute call we can walk you through how one of these was put together, and what a similar build would take for your business." />
</Base>
