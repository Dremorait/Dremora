---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../content/site';
import { pages } from '../../content/pages';
---
<Base page={pages.contactThanks}>
  <PageHero tall label="Message received" title="Your enquiry reached us" lead="We read every message ourselves. We will reply on the phone number or email you gave, with questions or a time for a call.">
    <div class="actions">
      <a class="btn btn-primary" href="/work">See our work</a>
      <a class="btn btn-secondary" href="/">Back to the home page</a>
    </div>
    <p class="contact-alt" style="color: var(--ink)">Anything urgent? <a href={`tel:${site.phone.e164}`}>Call {site.phone.display}</a> or <a href={site.whatsapp}>message us on WhatsApp</a>.</p>
  </PageHero>
</Base>
