---
import Base from '../../layouts/Base.astro';
import Fact from '../../components/Fact.astro';
import { services, known } from '../../content/site';
import { pages } from '../../content/pages';
---
<Base page={pages.services} crumbs={[{ name: 'Services', path: '/services' }]}>
  <section class="page-head wrap">
    <h1>Three things we build, and nothing we would have to learn on your money</h1>
    <p class="lead">Each one has a written scope, a fixed price and a timeline before any work starts.</p>
  </section>

  <section class="section" aria-labelledby="list-title">
    <div class="wrap">
      <h2 id="list-title" class="visually-hidden">Services</h2>
      <div class="rows">
        {services.map((s) => (
          <article class="row" id={s.slug === 'web-apps' ? 'webapps' : s.slug === 'ai-automation' ? 'ai' : s.slug}>
            <h3><a href={`/services/${s.slug}`}>{s.name}</a></h3>
            <div>
              <p>{s.short}</p>
              <p class="muted">For: {s.forWhom}</p>
            </div>
            <dl>
              <dt>Timeline</dt><dd class="mono">{s.timeline}</dd>
              {known(s.price) && <><dt>Starting at</dt><dd class="price"><Fact v={s.price} /></dd></>}
            </dl>
          </article>
        ))}
      </div>
      <div class="actions">
        <a class="btn btn-primary" href="/contact">Get a fixed quote</a>
        <span class="muted">Not sure which one you need? Choose "Not sure" in the form.</span>
      </div>
    </div>
  </section>

  {/* Old links like /services.html#webapps now point at their own pages. */}
  <script is:inline src="/services-hash.js" slot="head"></script>
</Base>
