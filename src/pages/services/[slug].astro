---
import Base from '../../layouts/Base.astro';
import Fact from '../../components/Fact.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Inbox from '../../components/mock/Inbox.astro';
import DemoReview from '../../components/mock/DemoReview.astro';
import Dashboard from '../../components/mock/Dashboard.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import VideoFrame from '../../components/VideoFrame.astro';
import { crmPromo } from '../../content/videos';
import { site, services, clientWork, portfolio, known, hasCaseStudy, workName, type Service } from '../../content/site';
import { pages } from '../../content/pages';
import { serviceNode } from '../../content/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Service };
const page = pages[`service-${s.slug}`];
const work = clientWork.filter((w) => s.relatedWork.includes(w.slug));
const demos = portfolio.filter((p) => s.relatedPortfolio.includes(p.slug));
const others = services.filter((o) => o.slug !== s.slug);
// 'Web applications' -> 'web applications', but 'AI automation and agents' and 'CRM' keep their capitals.
const inSentence = (name: string) => name.replace(/^[A-Z][a-z]/, (m) => m.toLowerCase());
const icons: Record<Service['slug'], string[]> = {
  websites: ['globe', 'page', 'cart', 'user'],
  'web-apps': ['grid', 'lock', 'box', 'wrench'],
  'custom-software': ['user', 'box', 'clock', 'link'],
  'ai-automation': ['laptop', 'chat', 'bell', 'link'],
};
const ctaTitle: Record<Service['slug'], string> = {
  websites: 'Ready to start your website?',
  'web-apps': 'Ready to plan your web app?',
  'custom-software': 'Ready to plan your CRM or ERP?',
  'ai-automation': 'Ready to automate the routine work?',
};
const crumbs = [{ name: 'Services', path: '/services' }, { name: s.name, path: `/services/${s.slug}` }];
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base page={page} crumbs={crumbs} schema={[serviceNode(s), faqSchema]}>
  <PageHero label={s.name} title={s.h1} lead={s.lead} crumbs={crumbs}>
    <div class="actions">
      <a class="btn btn-primary" href="/contact">Get a fixed quote</a>
      <a class="btn btn-secondary" href={site.whatsapp}>Message us on WhatsApp</a>
    </div>
    <ul class="chips">
      <li><b>Timeline</b> {s.timeline}</li>
      {known(s.price) && <li><b>Starting at</b> <Fact v={s.price} /></li>}
      <li><b>Built with</b> {s.stack}</li>
    </ul>
  </PageHero>

  <div class="wrap stage">
    {s.slug === 'ai-automation'
      ? <Inbox />
      : s.slug === 'custom-software'
      ? <VideoFrame {...crmPromo} />
      : (
        <figure class="panel" aria-labelledby="stage-caption">
          {s.slug === 'websites' ? <DemoReview /> : <Dashboard />}
          <figcaption id="stage-caption" class="visually-hidden">
            {s.slug === 'websites' ? 'Example: a weekly website demo with the client comments pinned on the page.' : 'Example: an admin panel for a coaching class, with made-up students.'}
          </figcaption>
        </figure>
      )}
  </div>

  <section class="section">
    <div class="wrap statement">{s.intro.map((p) => <p>{p}</p>)}</div>
  </section>

  <section class="section" aria-labelledby="for-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="for-title">Who this is for</h2>
        <p>{s.forWhom}</p>
      </div>
      <div class="icon-cards four">
        {s.kinds.map((k, i) => (
          <div class="icon-card">
            <Icon name={icons[s.slug][i]} />
            <h3>{k.name}</h3>
            <p>{k.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="inc-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="inc-title">Exactly what you get</h2>
        <p>Written into your quote, so nothing is a surprise later.</p>
      </div>
      <div class="compare">
        <div class="compare-card compare-in">
          <h2 style="font-size: 1.5rem">Included</h2>
          <ul class="ticks">{s.included.map((i) => <li>{i}</li>)}</ul>
        </div>
        <div class="compare-card compare-out">
          <h2 style="font-size: 1.5rem">Not included</h2>
          <ul class="ticks not">{s.notIncluded.map((i) => <li>{i}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  {(work.length > 0 || demos.length > 0) && (
  <section class="section" aria-labelledby="example-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="example-title">{work.length ? 'Real work, and what we can show' : 'Websites we built'}</h2>
      </div>
      <div class="cards cards-3">
        {work.map((w) => (
          <article class="card">
            <p class="label" style="margin: 0">Client work</p>
            <h3 style="font-size: 1.25rem">{workName(w)}</h3>
            <p class="muted">{w.built}</p>
            {hasCaseStudy(w) ? <a class="arrow-link" href={`/work/${w.slug}`}>Read the case study</a> : <a class="arrow-link" href="/work">See all client work</a>}
          </article>
        ))}
        {demos.map((p) => <PortfolioCard item={p} />)}
      </div>
    </div>
  </section>
  )}

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="faq-title">Questions people ask before starting</h2>
      </div>
      <div class="faq-cards">
        {s.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
      <p class="contact-alt">
        Also see {others.map((o, i) => <>{i > 0 && (i < others.length - 1 ? ', ' : others.length > 2 ? ', and ' : ' and ')}<a href={`/services/${o.slug}`}>{inSentence(o.name)}</a></>)}.
      </p>
    </div>
  </section>

  <CtaBand title={ctaTitle[s.slug]} />
</Base>
