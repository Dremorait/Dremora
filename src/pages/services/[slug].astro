---
import Base from '../../layouts/Base.astro';
import Fact from '../../components/Fact.astro';
import { services, clientWork, concepts, known, hasCaseStudy, workName, type Service } from '../../content/site';
import { pages } from '../../content/pages';
import { serviceNode } from '../../content/schema';

export function getStaticPaths() {
  return services.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props as { s: Service };
const page = pages[`service-${s.slug}`];
const work = clientWork.filter((w) => s.relatedWork.includes(w.slug));
const demos = concepts.filter((c) => s.relatedConcepts.includes(c.slug));
const others = services.filter((o) => o.slug !== s.slug);
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: s.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---
<Base page={page} crumbs={[{ name: 'Services', path: '/services' }, { name: s.name, path: `/services/${s.slug}` }]} schema={[serviceNode(s), faqSchema]}>
  <section class="page-head wrap">
    <p class="label">{s.name}</p>
    <h1>{s.h1}</h1>
    {s.intro.map((p) => <p>{p}</p>)}
    <dl class="facts">
      <dt>Timeline</dt><dd class="mono">{s.timeline}</dd>
      {known(s.price) && <><dt>Starting at</dt><dd class="price"><Fact v={s.price} /></dd></>}
      <dt>Built with</dt><dd>{s.stack}</dd>
    </dl>
    <div class="actions">
      <a class="btn btn-primary" href="/contact">Get a fixed quote</a>
    </div>
  </section>

  <section class="section" aria-labelledby="for-title">
    <div class="wrap grid">
      <div class="span-4">
        <h2 id="for-title">Who this is for</h2>
      </div>
      <div class="span-8">
        <p>{s.forWhom}</p>
        <div class="rows">
          {s.kinds.map((k) => (
            <div class="row row-2">
              <h3>{k.name}</h3>
              <p>{k.body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="inc-title">
    <div class="wrap grid">
      <div class="span-6">
        <h2 id="inc-title">What is included</h2>
        <ul class="ticks">{s.included.map((i) => <li>{i}</li>)}</ul>
      </div>
      <div class="span-6">
        <h2>What is not included</h2>
        <ul class="ticks not">{s.notIncluded.map((i) => <li>{i}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="example-title">
    <div class="wrap">
      <h2 id="example-title">{work.length ? 'Real example' : 'Example'}</h2>
      <div class="rows">
        {work.map((w) => (
          <article class="row row-2">
            <div>
              <h3>{workName(w)}</h3>
              <p class="label" style="margin: 8px 0 0">Client work</p>
            </div>
            <div>
              <p>{w.built}</p>
              {hasCaseStudy(w) ? <a href={`/work/${w.slug}`}>Read the case study</a> : <a href="/work">See all client work</a>}
            </div>
          </article>
        ))}
        {demos.map((c) => (
          <article class="row row-2">
            <div>
              <h3>{c.name}</h3>
              <p class="label" style="margin: 8px 0 0">Concept build, sample data</p>
            </div>
            <div>
              <p>{c.what}</p>
              <a href={`/work#${c.slug}`}>About this concept build</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="wrap grid">
      <div class="span-4">
        <h2 id="faq-title">Questions people ask before starting</h2>
      </div>
      <div class="span-8 faq">
        {s.faq.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="next-title">
    <div class="wrap">
      <h2 id="next-title">Ready for a number?</h2>
      <p>Send a short description of the business and what you need. We reply with questions or a call time, then a written fixed quote.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/contact">Get a fixed quote</a>
      </div>
      <p class="muted" style="margin-top: 32px">
        Also see: {others.map((o, i) => <>{i > 0 && ' and '}<a href={`/services/${o.slug}`}>{o.name.toLowerCase()}</a></>)}.
      </p>
    </div>
  </section>
</Base>
